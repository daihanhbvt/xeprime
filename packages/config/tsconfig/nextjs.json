{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "XePrime Next.js app",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "plugins": [{ "name": "next" }],

    /* React props are frequently spread; exactOptionalPropertyTypes makes that
       painful without catching real bugs in component code. Kept on everywhere else. */
    "exactOptionalPropertyTypes": false
  }
}
