{
  "openapi": "3.0.0",
  "paths": {
    "/auth/session": {
      "post": {
        "operationId": "AuthController_createSession",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeDto"
                }
              }
            }
          }
        },
        "summary": "Đăng nhập: đổi ID token lấy session cookie httpOnly",
        "tags": [
          "auth"
        ]
      },
      "delete": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Đăng xuất: xoá session cookie",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
