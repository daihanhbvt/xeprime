# Tên thương hiệu hiện trong app. Cặp song sinh của NEXT_PUBLIC_APP_NAME ở `.env` gốc repo —
# hai biến cho một giá trị vì mỗi bundler chỉ nhúng tiền tố của riêng nó, y như cặp API_URL.
# Bỏ trống thì `src/lib/app-name.ts` lùi về "XePrime".
# ⚠️ KHÔNG đổi được tên dưới biểu tượng app trên điện thoại — cái đó là `expo.name` ở app.json.
EXPO_PUBLIC_APP_NAME=XePrime

# Máy Android thật cắm USB (mặc định, `pnpm --filter @xeprime/mobile run android` tự mở tunnel):
EXPO_PUBLIC_API_URL="http://localhost:4000"

# Máy thật/emulator gọi qua Wi-Fi cùng mạng LAN — thay bằng IPv4 của PC (`ipconfig`):
# EXPO_PUBLIC_API_URL="http://192.168.1.183:4000"

# Bỏ trống hoàn toàn thì resolveApiBaseUrl() tự suy host từ Metro hostUri.

# --- Dùng API + database của STAGING ---------------------------------------
# Native (iOS/Android) không có CORS: trỏ thẳng là xong.
#   EXPO_PUBLIC_API_URL="https://api-stg.xeprime.vn"
#
# Bản WEB (`expo start --web`, localhost:8081) chạy trong trình duyệt nên KHÔNG trỏ thẳng được:
# staging từ chối origin http ngay lúc boot (`apps/api/src/config/env.schema.ts`), nên không có
# cách nào thêm localhost vào CORS_ORIGINS của nó. Đi qua proxy dev của Metro thay vào đó —
# đường dẫn bắt đầu bằng "/" nghĩa là "trên chính dev server", chạy đúng cho cả ba nền tảng:
#   STG_PROXY_TARGET="https://api-stg.xeprime.vn"
#   EXPO_PUBLIC_API_URL="/api/stg"
# Chi tiết và giới hạn: `scripts/stg-proxy-middleware.js`. Bỏ trống STG_PROXY_TARGET = tắt hẳn.
