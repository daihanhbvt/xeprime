{
  "name": "@xeprime/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build:deps": "pnpm --filter \"@xeprime/mobile^...\" run build",
    "start": "pnpm run build:deps && pnpm run adb:reverse && expo start",
    "android": "pnpm run build:deps && pnpm run adb:reverse && expo run:android",
    "ios": "pnpm run build:deps && expo run:ios",
    "web": "pnpm run build:deps && expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "sync:brand-art": "node scripts/sync-brand-art.mjs",
    "adb:reverse": "node scripts/adb-reverse.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@formatjs/intl-datetimeformat": "7.6.0",
    "@formatjs/intl-getcanonicallocales": "3.2.11",
    "@formatjs/intl-locale": "5.3.10",
    "@formatjs/intl-numberformat": "9.4.0",
    "@formatjs/intl-pluralrules": "6.3.13",
    "@hookform/resolvers": "5.4.0",
    "@reduxjs/toolkit": "2.12.0",
    "@tamagui/animations-react-native": "2.7.7",
    "@tamagui/core": "2.7.7",
    "@tamagui/toast": "2.7.7",
    "@tanstack/react-query": "5.101.4",
    "@xeprime/api-client": "workspace:*",
    "@xeprime/domain": "workspace:*",
    "@xeprime/types": "workspace:*",
    "@xeprime/ui": "workspace:*",
    "@xeprime/validators": "workspace:*",
    "dayjs": "1.11.21",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "14.0.8",
    "expo-image-picker": "17.0.11",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.82.0",
    "react-native": "0.81.5",
    "react-native-calendars": "1.1314.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "9.3.0",
    "tamagui": "2.7.7",
    "use-intl": "4.13.7",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@tamagui/babel-plugin": "2.7.7",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "jest": "29.7.0",
    "jest-expo": "~54.0.18",
    "test-renderer": "1.2.0",
    "typescript": "5.9.3"
  }
}
