{
  "expo": {
    "name": "XePrime Partner",
    "slug": "xeprime-partner",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "xeprimepartner",
    "userInterfaceStyle": "automatic",
    "icon": "../shared/assets/images/xeprime-partner-icon.png",
    "ios": {
      "bundleIdentifier": "vn.xeprime.partnerapp",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "vn.xeprime.partnerapp",
      "versionCode": 6,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "../shared/assets/images/xeprime-partner-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "../shared/assets/images/xeprime-mark.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#faf9f7"
        }
      ],
      "expo-localization",
      "expo-web-browser",
      "expo-font",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "XePrime Partner cần truy cập thư viện ảnh để bạn tải ảnh xe, giấy tờ xe, logo và ảnh gian hàng, ảnh bàn giao xe, chứng từ thu chi và ảnh gửi trong tin nhắn với khách."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "XePrime Partner chỉ dùng vị trí khi bạn đang mở ứng dụng, để điền nhanh địa chỉ chi nhánh và điểm giao, nhận xe.",
          "locationWhenInUsePermission": "XePrime Partner dùng vị trí của bạn để điền nhanh địa chỉ chi nhánh và điểm giao, nhận xe trên bản đồ. Bạn vẫn có thể tự nhập địa chỉ.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "XePrime Partner cần dùng máy ảnh để bạn chụp ảnh xe, giấy tờ xe và ảnh tình trạng xe khi bàn giao, nhận lại xe.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
