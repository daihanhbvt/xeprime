{
  "expo": {
    "name": "XePrime Partner",
    "slug": "xeprime-partner",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "xeprimepartner",
    "userInterfaceStyle": "light",
    "icon": "../shared/assets/images/xeprime-partner-icon.png",
    "ios": {
      "bundleIdentifier": "vn.xeprime.partner",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "vn.xeprime.partner",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "../shared/assets/images/xeprime-partner-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "../shared/assets/images/xeprime-mark.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#faf9f7"
        }
      ],
      "expo-localization",
      "expo-web-browser",
      "expo-font",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "XePrime Partner cần quyền truy cập thư viện ảnh để bạn chọn ảnh từ máy (ảnh đại diện, hồ sơ, xe, giấy tờ và các nội dung khác trong ứng dụng)."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "XePrime Partner dùng vị trí của bạn để mở sẵn danh sách xe ở tỉnh/thành bạn đang đứng. Bạn có thể đổi địa điểm bất cứ lúc nào.",
          "locationWhenInUsePermission": "XePrime Partner dùng vị trí của bạn để mở sẵn danh sách xe ở tỉnh/thành bạn đang đứng. Bạn có thể đổi địa điểm bất cứ lúc nào.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "XePrime Partner cần quyền máy ảnh để bạn chụp ảnh ngay trong ứng dụng (ảnh đại diện, hồ sơ, xe, giấy tờ và các nội dung khác).",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
