{
  "expo": {
    "name": "XePrime",
    "slug": "xeprime-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "xeprime",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/xeprime-icon.png",
    "ios": {
      "bundleIdentifier": "vn.xeprime.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "vn.xeprime.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/xeprime-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/xeprime-mark.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#faf9f7"
        }
      ],
      "expo-localization",
      "expo-web-browser",
      "expo-font",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "XePrime cần quyền truy cập thư viện ảnh để bạn chọn ảnh hiện trạng xe khi lập biên bản bàn giao."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "XePrime cần quyền máy ảnh để bạn chụp ảnh hiện trạng xe ngay trong ứng dụng.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
