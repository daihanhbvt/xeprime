{
  "expo": {
    "name": "XePrime",
    "slug": "xeprime-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "xeprime",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "vn.xeprime.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "vn.xeprime.mobile",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-web-browser",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "XePrime cần quyền truy cập thư viện ảnh để bạn chọn ảnh hiện trạng xe khi lập biên bản bàn giao.",
          "cameraPermission": "XePrime cần quyền máy ảnh để bạn chụp ảnh hiện trạng xe khi giao và nhận lại xe."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
