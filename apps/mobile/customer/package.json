{
  "name": "@xeprime/mobile-customer",
  "version": "0.0.0",
  "private": true,
  "//": [
    "APP KHÁCH — XePrime (vn.xeprime.mobile). Một trong HAI app phát hành riêng.",
    "Khai lại cùng bộ thư viện với manage/ và shared/ là BẮT BUỘC, không phải trùng lặp:",
    "  • autolinking đọc FILE NÀY để biết nhúng native module nào vào chính bản cài này;",
    "  • Metro chỉ tìm thư viện ở customer/node_modules và node_modules gốc repo.",
    "Không có version nào ở đây: mọi số thật nằm ở pnpm-workspace.yaml (catalog:).",
    "Canh ba file khớp nhau: pnpm mobile:deps:check"
  ],
  "main": "expo-router/entry",
  "scripts": {
    "build:deps": "pnpm --filter \"@xeprime/mobile-customer^...\" run build",
    "start": "pnpm run build:deps && pnpm run adb:reverse && expo start --port 8081",
    "android": "pnpm run build:deps && pnpm run adb:reverse && expo run:android --port 8081",
    "ios": "pnpm run build:deps && expo run:ios --port 8081",
    "web": "pnpm run build:deps && expo start --web --port 8081",
    "prebuild:clean": "expo prebuild --clean",
    "prebuild": "expo prebuild --platform android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "adb:reverse": "node ../shared/scripts/adb-reverse.mjs 8081",
    "build:android:debug": "node ../shared/scripts/gradle.mjs assembleDebug",
    "clean:android": "node ../shared/scripts/gradle.mjs clean",
    "install:android": "node ../shared/scripts/install-android.mjs",
    "build:android:apk": "eas build --platform android --profile preview --local",
    "build:android:aab": "eas build --platform android --profile production --local"
  },
  "dependencies": {
    "@expo/metro-runtime": "catalog:",
    "@expo/vector-icons": "catalog:",
    "@formatjs/intl-datetimeformat": "catalog:",
    "@formatjs/intl-getcanonicallocales": "catalog:",
    "@formatjs/intl-locale": "catalog:",
    "@formatjs/intl-numberformat": "catalog:",
    "@formatjs/intl-pluralrules": "catalog:",
    "@hookform/resolvers": "catalog:",
    "@react-native-firebase/app": "catalog:",
    "@react-native-firebase/messaging": "catalog:",
    "@reduxjs/toolkit": "catalog:",
    "@tamagui/animations-react-native": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/toast": "catalog:",
    "@tanstack/react-query": "catalog:",
    "dayjs": "catalog:",
    "expo": "catalog:",
    "expo-build-properties": "catalog:",
    "expo-camera": "catalog:",
    "expo-clipboard": "catalog:",
    "expo-constants": "catalog:",
    "expo-crypto": "catalog:",
    "expo-document-picker": "catalog:",
    "expo-font": "catalog:",
    "expo-image": "catalog:",
    "expo-image-manipulator": "catalog:",
    "expo-image-picker": "catalog:",
    "expo-linear-gradient": "catalog:",
    "expo-linking": "catalog:",
    "expo-localization": "catalog:",
    "expo-location": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-splash-screen": "catalog:",
    "expo-web-browser": "catalog:",
    "firebase": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-native": "catalog:",
    "react-native-calendars": "catalog:",
    "react-native-gifted-charts": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-web": "catalog:",
    "react-native-webview": "catalog:",
    "react-native-worklets": "catalog:",
    "react-redux": "catalog:",
    "tamagui": "catalog:",
    "use-intl": "catalog:",
    "yup": "catalog:",
    "@xeprime/api-client": "workspace:*",
    "@xeprime/domain": "workspace:*",
    "@xeprime/types": "workspace:*",
    "@xeprime/ui": "workspace:*",
    "@xeprime/validators": "workspace:*",
    "@xeprime/mobile-shared": "workspace:*"
  },
  "devDependencies": {
    "@tamagui/babel-plugin": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "jest": "catalog:",
    "jest-expo": "catalog:",
    "test-renderer": "catalog:",
    "typescript": "catalog:"
  }
}
