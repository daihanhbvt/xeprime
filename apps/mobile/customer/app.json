{
  "expo": {
    "name": "XePrime",
    "slug": "xeprime-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "xeprime",
    "userInterfaceStyle": "automatic",
    "icon": "../shared/assets/images/xeprime-icon.png",
    "ios": {
      "bundleIdentifier": "vn.xeprime.customerapp",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "vn.xeprime.customerapp",
      "versionCode": 12,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "../shared/assets/images/xeprime-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "../shared/assets/images/xeprime-mark.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#faf9f7"
        }
      ],
      "expo-localization",
      "expo-web-browser",
      "expo-font",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "XePrime cần truy cập thư viện ảnh để bạn chọn ảnh đại diện, ảnh bằng lái xe khi xác minh thuê xe, và ảnh gửi trong tin nhắn với chủ xe."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "XePrime chỉ dùng vị trí khi bạn đang mở ứng dụng, để gợi ý xe gần bạn và điền nhanh địa chỉ nhận hoặc giao xe.",
          "locationWhenInUsePermission": "XePrime dùng vị trí của bạn để gợi ý xe ở tỉnh/thành bạn đang đứng và điền nhanh địa chỉ nhận hoặc giao xe. Bạn vẫn có thể tự chọn địa điểm khác.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "XePrime cần dùng máy ảnh để bạn chụp ảnh bằng lái xe khi xác minh thuê xe, ảnh đại diện và ảnh gửi trong tin nhắn với chủ xe.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
