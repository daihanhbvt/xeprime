{
  "name": "@xeprime/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- node --import tsx --test \"test/**/*.test.ts\"",
    "holidays:sync": "dotenv -e ../../.env -- tsx src/scripts/sync-holidays.ts"
  },
  "dependencies": {
    "@xeprime/domain": "workspace:*",
    "@xeprime/prisma": "workspace:*",
    "@xeprime/types": "workspace:*",
    "firebase-admin": "14.2.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "dotenv-cli": "11.0.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
