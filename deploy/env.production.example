# XePrime — cấu hình một môi trường đã triển khai. CHÉP file này ở GỐC REPO trên VPS:
#
#   cp deploy/env.production.example .env.production && chmod 600 .env.production   # máy production
#   cp deploy/env.production.example .env.staging    && chmod 600 .env.staging      # máy staging
#
# MỘT file mẫu cho cả hai môi trường, không phải hai: giữ hai bản gần giống nhau là cách một
# biến mới được thêm vào bản này và bị quên ở bản kia. Phần khác nhau giữa staging và
# production liệt kê ở `docs/deployment.md` §2.3 — đọc nó trước khi điền, đặc biệt là
# `SESSION_COOKIE_NAME` (để giống nhau thì đăng nhập staging đá văng phiên production).
#
# Tên file quyết định môi trường: `deploy.sh --env staging` đọc `.env.staging` và chạy dưới
# project Docker `xeprime-staging`. Không có cờ thì mặc định là `production`.
#
# File `.env.*` KHÔNG BAO GIỜ được commit (`.gitignore` đã chặn).
#
# Nó có HAI vai cùng lúc, và đó là lý do vài biến trông như trùng nhau:
#   1. `env_file` của mọi container → biến runtime cho api/web/worker/migrate;
#   2. `--env-file` của docker compose → nội suy `${...}` trong docker-compose.prod.yml
#      (WEB_DOMAIN, POSTGRES_PASSWORD, và các NEXT_PUBLIC_* dùng làm --build-arg).
#
# ⚠️ `apps/api/src/config/env.schema.ts` CHẶN BOOT ở production nếu thiếu/sai. Đây là cố ý:
#    một API production gửi OTP ra log hay ghi link đặt lại mật khẩu ra log thì đã hỏng rồi,
#    và biết điều đó lúc boot rẻ hơn nhiều so với biết lúc khách hàng đầu tiên bấm nút.
#    Bắt buộc ở MỌI môi trường đã triển khai (kể cả staging): API_PUBLIC_URL và APP_WEB_URL là
#    https tên miền thật · CORS_ORIGINS toàn https · SESSION_COOKIE_SECURE=true ·
#    SESSION_JWT_SECRET và OTP_PEPPER không còn chữ "change-me".
#    Chỉ bắt buộc khi APP_ENV=production: OTP_MODE=esms + 3 ESMS_* · SMTP_HOST/USER/PASS ·
#    7 biến R2_*.

# ===========================================================================
# 1. Tên miền — điền TRƯỚC, mọi mục dưới suy ra từ đây
# ===========================================================================
# Chỉ dùng bởi Caddy (xin chứng chỉ Let's Encrypt) và docker-compose.prod.yml.
# A record của CẢ HAI phải trỏ về IP VPS trước khi `up` lần đầu.
WEB_DOMAIN=xeprime.vn
API_DOMAIN=api.xeprime.vn
# Email nhận cảnh báo chứng chỉ sắp hết hạn từ Let's Encrypt.
ACME_EMAIL=admin@xeprime.vn

# ===========================================================================
# 2. PostgreSQL
# ===========================================================================
POSTGRES_USER=xeprime
# Sinh: openssl rand -base64 32
POSTGRES_PASSWORD=DOI_MAT_KHAU_NAY
POSTGRES_DB=xeprime
# Host là `db` — TÊN SERVICE trong compose, không phải localhost: api/worker chạy trong
# container riêng và `localhost` ở đó là chính nó.
DATABASE_URL="postgresql://xeprime:DOI_MAT_KHAU_NAY@db:5432/xeprime?schema=public&connection_limit=10"

# ===========================================================================
# 3. API
# ===========================================================================
NODE_ENV=production

# ⚠️ BIẾN QUYẾT ĐỊNH MÁY NÀY LÀ MÔI TRƯỜNG NÀO. Trên máy staging đổi thành `staging`.
#
# `NODE_ENV` phải là `production` ở CẢ HAI máy (nếu không Next trộn bản React dev vào bundle).
# `APP_ENV` mới là thứ tách hai nhóm luật:
#   • BẢO MẬT (https · cookie Secure · secret không còn giá trị mẫu · CORS) — áp cho CẢ HAI.
#     Staging cũng nằm trên Internet công khai và cũng phát cookie phiên thật.
#   • NĂNG LỰC (eSMS · SMTP · R2) — chỉ `production`. Ở staging thiếu chúng thì mã OTP in ra log
#     và trả trong response, email đặt lại mật khẩu in ra log, endpoint upload trả 503. App vẫn
#     chạy đủ để test luồng.
#
# ⚠️ Hệ quả của việc để `staging`: response của gửi OTP có `devCode` — ai gọi được endpoint đó
#    cũng xác thực được SĐT bất kỳ. Vì vậy KHÔNG đưa dữ liệu khách hàng thật lên staging.
APP_ENV=production

API_PORT=4000

# Danh sách origin CHÍNH XÁC được gọi API kèm cookie. Production bắt buộc https, cấm "*".
# KHÔNG cần thêm `www`: Caddy chuyển hướng 301 www về tên miền gốc, nên origin mà trình duyệt
# gửi lên luôn là tên miền gốc. Ba giao diện (chợ xe `/`, cổng quản lý `/manage`, quản trị nền
# tảng `/manage/admin`) dùng CHUNG một origin — chúng là cùng một app Next, phân vai bằng
# đường dẫn chứ không phải bằng tên miền.
CORS_ORIGINS="https://xeprime.vn"

# Số lớp proxy đứng trước API. Ở kiến trúc này đúng bằng 1 (Caddy).
# 0 (mặc định, dành cho dev) nghĩa là Express lấy IP của container Caddy làm IP client —
# và khi đó @nestjs/throttler gộp TOÀN BỘ người dùng vào chung một hạn mức 120 request/phút.
# Đặt >0 chỉ đúng khi proxy thật sự tồn tại: tin X-Forwarded-For khi không có proxy là để
# bất kỳ ai cũng tự khai IP của mình.
TRUST_PROXY_HOPS=1

# URL công khai của chính API. `redirect_uri` của Google/Facebook dựng từ đây và phải TRÙNG
# TỪNG KÝ TỰ với giá trị khai trong console của provider.
API_PUBLIC_URL="https://api.xeprime.vn"
# Link trong email đặt lại mật khẩu dựng từ đây.
APP_WEB_URL="https://xeprime.vn"

# ===========================================================================
# 4. Phiên (ADR 0002 web · ADR 0017 native)
# ===========================================================================
# Sinh: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_JWT_SECRET="DOI_GIA_TRI_NAY_toi_thieu_32_ky_tu"
SESSION_TTL_DAYS=7
# Đọc bởi CẢ API (phát cookie) lẫn tiến trình web (`proxy.ts` chặn `/manage/*`) — compose truyền
# nó vào service `web` qua `environment:`. Hai bên lệch tên là proxy không bao giờ thấy phiên.
SESSION_COOKIE_NAME=xp_session
SESSION_COOKIE_SECURE=true
# Dấu chấm đầu là thứ cho phép cookie phát từ api.xeprime.vn dùng được ở xeprime.vn.
SESSION_COOKIE_DOMAIN=.xeprime.vn

MOBILE_ACCESS_TTL_MINUTES=15
MOBILE_REFRESH_TTL_DAYS=60
MOBILE_JWT_AUDIENCE=xeprime-mobile
# Allowlist deep link nhận one-time code sau đăng nhập mạng xã hội trên app native (ADR 0019).
MOBILE_AUTH_REDIRECT_URIS="xeprime://auth/callback"

# ===========================================================================
# 5. Đăng nhập Google / Facebook (ADR 0019) — TUỲ CHỌN
# ===========================================================================
# Bỏ trống CẢ CẶP thì nút tương ứng trả SOCIAL_NOT_CONFIGURED; mật khẩu và OTP vẫn chạy.
# Khai NỬA cặp thì API từ chối boot — đó luôn là gõ thiếu.
# Redirect URI phải khai trong console: https://api.xeprime.vn/auth/social/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ===========================================================================
# 6. OTP qua SMS — bắt buộc khi APP_ENV=production (staging để `mock`, mã vào log + devCode)
# ===========================================================================
OTP_MODE=esms
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
OTP_TTL_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
# Sinh: openssl rand -base64 32
OTP_PEPPER="DOI_GIA_TRI_NAY_toi_thieu_16_ky_tu"

# ===========================================================================
# 7. SMTP — bắt buộc khi APP_ENV=production (staging bỏ trống được: email in ra log)
# ===========================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="XePrime <no-reply@xeprime.vn>"

# ===========================================================================
# 8. Cloudflare R2 — bắt buộc khi APP_ENV=production (staging bỏ trống được: upload trả 503)
# ===========================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=xeprime-public
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_PUBLIC_BASE_URL="https://cdn.xeprime.vn"
# Bucket RIÊNG TƯ: KHÔNG bật r2.dev URL, KHÔNG gắn custom domain public. File chỉ ra ngoài
# qua signed URL ngắn hạn sau khi backend kiểm quyền.
R2_PRIVATE_BUCKET=xeprime-private

# ===========================================================================
# 9. Tuỳ chọn — thiếu thì tính năng tương ứng lặng lẽ tắt, app vẫn chạy
# ===========================================================================
# Chat realtime (ADR 0009). Bật thì cần cả ba FIREBASE_* dưới.
FIRESTORE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Dán nguyên khoá kèm dòng BEGIN/END, xuống dòng viết là \n.
FIREBASE_PRIVATE_KEY=

# Server key: CHỈ bật Geocoding API + Routes API, khoá theo IP VPS. Thiếu → phí giao dự kiến
# không hiện, hai bên tự thoả thuận (ADR 0018).
GOOGLE_MAPS_SERVER_KEY=
# Key RIÊNG cho worker: CHỈ bật Google Calendar API. Thiếu → lịch xe không có lớp ngày lễ.
GOOGLE_HOLIDAY_API_KEY=
GOOGLE_HOLIDAY_CALENDAR_ID="vi.vietnamese#holiday@group.v.calendar.google.com"

# ===========================================================================
# 10. Biến BUILD-TIME của web — Next nhúng cứng vào bundle
# ===========================================================================
# Đổi bất kỳ giá trị nào ở mục này thì PHẢI build lại image (`deploy/scripts/deploy.sh` làm
# việc đó). Sửa mà chỉ `restart` là không có gì thay đổi trên trình duyệt.
#
# Trình duyệt của khách gọi thẳng giá trị này, nên nó là URL CÔNG KHAI của API — không phải
# `http://api:4000` (tên nội bộ của compose, máy khách không phân giải được).
NEXT_PUBLIC_API_URL="https://api.xeprime.vn"
NEXT_PUBLIC_APP_NAME=XePrime
# Key nhúng bản đồ — nằm lộ thiên trong HTML nên phải là key RIÊNG: chỉ bật Maps Embed API và
# khoá theo referrer. KHÔNG dùng chung với GOOGLE_MAPS_SERVER_KEY ở trên.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===========================================================================
# 11. Sao lưu (deploy/scripts/backup-db.sh)
# ===========================================================================
# Số ngày giữ bản dump trên đĩa VPS.
BACKUP_KEEP_DAYS=14
# Đích sao lưu ngoài máy, dạng rclone remote (ví dụ "r2:xeprime-backup").
# Bỏ trống = chỉ sao lưu tại chỗ, và khi đó VPS chết là mất dữ liệu.
BACKUP_RCLONE_REMOTE=
