strict-peer-dependencies=false
auto-install-peers=true

# Prisma CLI resolves its engines from the package root; isolated linking hides them
# from the generated client when @prisma/client is consumed across workspace packages.
public-hoist-pattern[]=*prisma*

# Mạng ở môi trường dev hiện tại chậm (~20 KiB/s) và pnpm mặc định bỏ cuộc quá sớm.
# Các giá trị này chỉ ảnh hưởng tốc độ cài, không ảnh hưởng kết quả.
fetch-retries=6
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
fetch-timeout=900000
network-concurrency=4
