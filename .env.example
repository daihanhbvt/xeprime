# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database (ADR 0001: PostgreSQL 16) -----------------------------------
# Matches docker-compose.yml. Change the password before any non-local use.
DATABASE_URL="postgresql://xeprime:xeprime_dev_pw@localhost:5432/xeprime?schema=public"
# Database RIÊNG cho `pnpm --filter @xeprime/api test` (spec chạy trên PostgreSQL thật — ADR
# 0006). Không đặt thì test ghi vào DATABASE_URL ở trên, tức database dev, kèm cảnh báo.
# Tạo: docker compose exec db createdb -U xeprime xeprime_test  &&  pnpm db:deploy (với URL này)
TEST_DATABASE_URL="postgresql://xeprime:xeprime_dev_pw@localhost:5432/xeprime_test?schema=public"

# --- API ------------------------------------------------------------------
# Biến này dành cho apps/api. KHÔNG để nó chạm tới `next build`: build của web nạp chính
# file .env này qua dotenv, và một `next build` thấy NODE_ENV=development sẽ trộn bản React
# dev với bản production trong cùng bundle server — prerender /_global-error nổ
# "Cannot read properties of null (reading useContext)". Vì vậy script build của web ghi đè
# tường minh: `dotenv -e ../../.env -v NODE_ENV=production -- next build`.
NODE_ENV=development

# MÔI TRƯỜNG ĐÃ TRIỂN KHAI.
#   production (mặc định) → đòi đủ eSMS + SMTP + R2 lúc boot
#   staging               → miễn ba thứ đó (OTP in ra log và trả devCode, email in ra log,
#                           upload trả 503), nhưng KHÔNG miễn bất kỳ luật bảo mật nào.
# Mặc định cố ý là giá trị NGHIÊM NGẶT nhất: nới lỏng phải là hành động tường minh.
#
# ⚠️ Với API thì biến này chỉ có nghĩa khi NODE_ENV=production — ở dev để nguyên là được.
# NHƯNG SEED thì ĐỌC NÓ Ở MỌI MÔI TRƯỜNG: `APP_ENV=production` nghĩa là "database này có dữ
# liệu khách hàng thật", nên `pnpm db:seed` (SEED_MODE=demo) sẽ TỪ CHỐI chạy. Trên máy dev,
# đặt `APP_ENV=development` trong `.env` của bạn, hoặc chạy một lần:
#   APP_ENV=development pnpm --filter @xeprime/prisma seed
# Giữ `production` ở file MẪU này là có chủ đích: CI copy nó thành `.env` và CI không seed demo.
APP_ENV=production

API_PORT=4000
# Comma-separated list of EXACT origins. Ở production: bắt buộc https, cấm "*" (API validate
# lúc boot). Mở web qua IP LAN thì thêm đúng origin đó, ví dụ:
#   CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.210:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000, http://localhost:8081"

# Số lớp reverse proxy đứng TRƯỚC API (giá trị `trust proxy` của Express). Dev chạy trần nên 0;
# production sau Caddy là 1 (xem deploy/env.production.example). Để 0 khi CÓ proxy nghĩa là mọi
# người dùng chung một `req.ip` và rate limit gộp cả hệ thống làm một; bật khi KHÔNG có proxy
# nghĩa là ai cũng tự khai IP của mình qua header X-Forwarded-For.
TRUST_PROXY_HOPS=0

# --- Session (ADR 0002: httpOnly cookie issued by NestJS) -----------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_JWT_SECRET="change-me-dev-only-do-not-use-in-production-000000000000"
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=xp_session
# false only for local http. MUST be true in production.
SESSION_COOKIE_SECURE=false
# Leave empty for localhost; set to the apex domain in production.
SESSION_COOKIE_DOMAIN=

# --- Phiên app native (ADR 0017) — Bearer access token + refresh token xoay vòng ---
# Access token JWT ngắn hạn. Chỉ nhận 10–15 (chặn ở env.schema.ts): đây là cửa sổ mà một access
# token bị lộ còn dùng được SAU KHI phiên đã bị thu hồi, không phải một con số cho tiện.
MOBILE_ACCESS_TTL_MINUTES=15
# Refresh token opaque, xoay mỗi lần dùng. Dài hơn nhiều vì nó thu hồi được tức thì qua DB.
MOBILE_REFRESH_TTL_DAYS=60
# Claim `aud` của access token. Cùng với `typ=access`, đây là thứ chặn session JWT của web
# (cùng secret, cùng issuer) đi lẫn sang đường Bearer.
MOBILE_JWT_AUDIENCE=xeprime-mobile

# Deep link được phép nhận one-time code sau khi app native đăng nhập Google/Facebook (ADR 0019).
# Là ALLOWLIST: app phải gửi `redirect_uri` NẰM TRONG danh sách này. Redirect tới một URI do
# client tự khai là cách one-time code được giao thẳng cho kẻ tấn công.
#
# Nhiều giá trị, phân tách bằng dấu phẩy, vì dev khác production: Expo dev build trả
# `exp://192.168.x.x:8081/--/auth/callback` chứ không phải scheme của app đã cài. Thêm URI dev
# vào đây, ĐỪNG nới lỏng luật.
MOBILE_AUTH_REDIRECT_URIS="xeprime://auth/callback"

# --- Đăng nhập Google / Facebook (ADR 0019) --------------------------------
# Vòng OAuth chạy HOÀN TOÀN ở server: hai secret dưới đây không bao giờ rời tiến trình API, và
# trình duyệt cũng không bao giờ cầm access token của provider.
#
# Không provider nào bắt buộc (kể cả ở production): bỏ trống cả cặp thì nút tương ứng trả
# SOCIAL_NOT_CONFIGURED, còn mật khẩu/OTP vẫn chạy. Nhưng khai NỬA cặp thì API từ chối boot —
# đó luôn là gõ thiếu.
#
# Google Cloud Console → Credentials → OAuth client ID → Web application.
#   Authorized redirect URI: <API_PUBLIC_URL>/auth/social/google/callback
#   Scope chỉ `openid email profile` (không nhạy cảm ⇒ không phải qua thẩm định bảo mật).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Meta for Developers → App → Facebook Login → Settings.
#   Valid OAuth Redirect URI: <API_PUBLIC_URL>/auth/social/facebook/callback
#   Quyền `email` cần App Review trước khi app rời chế độ development.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# URL công khai của chính API — `redirect_uri` của OAuth dựng từ đây và phải TRÙNG TỪNG KÝ TỰ
# với giá trị đã khai trong console của Google/Facebook. Production bắt buộc https tên miền thật
# (API từ chối boot nếu trỏ localhost).
API_PUBLIC_URL="http://localhost:4000"

# --- Firebase Admin: chat realtime (ADR 0009) + thông báo đẩy FCM ----------
# Từ ADR 0019, Firebase KHÔNG còn nằm trên đường đăng nhập. Nó phục vụ HAI tính năng bật/tắt
# độc lập — FIRESTORE_ENABLED (chat realtime) và PUSH_ENABLED (thông báo đẩy) — nhưng dùng CHUNG
# một project và một service account. Ba biến này bắt buộc khi bất kỳ cờ nào trong hai cờ đó bật.
# Service account cần vai trò "Firebase Cloud Messaging API Admin" và FCM API phải được bật
# trên Google Cloud Console (docs/third-party-keys.md §7).
# ⚠️ Private key CHỈ ở backend/worker. KHÔNG bao giờ đưa vào app native hay web.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole key including BEGIN/END lines, with literal \n for newlines.
FIREBASE_PRIVATE_KEY=

# --- Xác thực SĐT / OTP (Phase 4) -----------------------------------------
# mock -> sinh mã 6 số, KHÔNG gửi SMS: in ra log + trả devCode ở dev để test luồng.
# esms -> gửi thật qua eSMS.vn, cần 3 ESMS_* dưới (tài khoản eSMS riêng; key prod của
#         Firebase-code nằm trong Secret Manager, không lấy về local được).
OTP_MODE=mock
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
OTP_TTL_MINUTES=5

# --- Năng lực theo gói (ADR 0027) ------------------------------------------
# off | warn | on. `warn` (mặc định) ghi log ai SẼ bị chặn nhưng vẫn cho qua — dùng để đo trước
# khi bật thật. Bật `on` ở môi trường đã triển khai là một lần deploy RIÊNG (deployment.md §9.4b).
PLAN_FEATURE_ENFORCEMENT=warn
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
# Số lần nhập SAI tối đa cho một mã trước khi khoá mã (chống brute-force).
OTP_MAX_ATTEMPTS=5
# Bí mật để hash mã OTP. Đổi giá trị này trước khi lên production.
OTP_PEPPER="xeprime-dev-otp-pepper-change-me"

# --- Chat realtime (ADR 0009) ---------------------------------------------
# true -> đẩy chat sang Firestore (realtime) + bật đính kèm R2. Cần 3 FIREBASE_* trên
# và các R2_* dưới. false (mặc định) -> chat chỉ chạy trên Postgres.
FIRESTORE_ENABLED=false

# --- Thông báo đẩy qua FCM (10/09/2026) -----------------------------------
# ĐỘC LẬP với FIRESTORE_ENABLED — bật push mà tắt chat realtime là cấu hình hợp lệ (và là cấu
# hình của giai đoạn này). Cần 3 FIREBASE_* trên.
#   false (mặc định) -> API vẫn NHẬN đăng ký thiết bị (POST /notifications/device-token) nhưng
#                       không tạo `push_deliveries`, và worker không đăng ký vòng lặp gửi. Nhờ
#                       vậy bật lên sau không làm nổ ra một trận thông báo tồn đọng.
#   true             -> API xếp hàng trong cùng transaction nghiệp vụ, worker gửi qua FCM.
# Thử thật: pnpm push:smoke -- --user-email <email>   (xem docs/push-notifications.md)
PUSH_ENABLED=false

# --- Object storage: Cloudflare R2 (S3-compatible) ------------------------
# Dùng cho đính kèm chat VÀ upload ảnh xe/shop ở portal quản lý (POST /uploads/*/presign).
# Thiếu bộ R2_* thì endpoint upload ảnh trả 503 UPLOADS_NOT_CONFIGURED (app vẫn boot bình thường).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Ví dụ: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# URL công khai của bucket (custom domain hoặc r2.dev) để dựng link file.
R2_PUBLIC_BASE_URL=
# Bucket RIÊNG TƯ cho tài liệu nhạy cảm (hợp đồng nguồn xe). Bucket này KHÔNG được bật
# r2.dev URL hay public custom domain — file chỉ truy cập qua signed URL ngắn hạn sau khi
# backend kiểm quyền. Thiếu thì endpoint hợp đồng trả 503, KHÔNG rơi về bucket public.
R2_PRIVATE_BUCKET=

# --- Bản đồ: khoảng cách giao xe tận nơi (Geoapify/OSM — ADR 0037) ----------
# SERVER key của Geoapify. Đăng ký ở https://myprojects.geoapify.com — gói miễn phí 3.000
# credit/ngày, KHÔNG cần thẻ tín dụng. Trong Projects → API keys: khoá key này theo IP của máy
# chạy API. Backend dùng nó cho geocoding, gợi ý địa điểm và định tuyến.
# Thiếu key thì phí giao dự kiến không hiện, ô gợi ý địa chỉ rơi về nhập tay, luồng đặt xe vẫn
# chạy như cách cũ (hai bên tự thoả thuận) — app KHÔNG gãy.
# ⚠ KHÔNG dùng chung với key bản đồ của web (NEXT_PUBLIC_GEOAPIFY_MAP_KEY bên dưới): key đó
#   nằm lộ thiên trong bundle nên phải là key RIÊNG, khoá theo HTTP referrer. Trộn hai key lại
#   là mở hạn mức của mình cho bất kỳ ai xem trang.
GEOAPIFY_API_KEY=

# --- Ngày lễ Việt Nam: đồng bộ từ Google Calendar --------------------------
# Dùng bởi WORKER (apps/worker), mỗi ngày một lần sau 06:00 giờ VN. API chỉ đọc bảng
# public_holidays và không bao giờ gọi Google.
#
# Trên Cloud Console: tạo key riêng và CHỈ bật Google Calendar API.
# ⚠ KHÔNG dùng lại GEOAPIFY_API_KEY ở trên, và cũng không thể: từ ADR 0037 bản đồ chạy trên
#   Geoapify/OSM, còn lịch nghỉ lễ vẫn là Google Calendar API. Hai nhà cung cấp khác nhau.
# Bỏ trống thì worker không đăng ký vòng lặp đồng bộ (nói một dòng lúc boot), GET /holidays trả
# danh sách rỗng, và lịch xe chạy bình thường — chỉ không có lớp ngày lễ.
GOOGLE_HOLIDAY_API_KEY=
# Lịch nguồn. Bỏ trống = lịch nghỉ lễ VN CÔNG KHAI của Google (mặc định bên dưới) — công khai
# nên chỉ cần API key, không OAuth, không service account.
GOOGLE_HOLIDAY_CALENDAR_ID="vi.vietnamese#holiday@group.v.calendar.google.com"
# Chạy đồng bộ ngay, bất kể giờ giấc: pnpm --filter @xeprime/worker holidays:sync

# --- Seed ------------------------------------------------------------------
# demo   (mặc định) = dữ liệu nền + 5 gian hàng/xe/đơn/sổ sách minh hoạ. Chỉ cho dev/demo.
# system            = CHỈ permission + role hệ thống + danh mục thu/chi + gói dịch vụ. Đây là
#                     chế độ duy nhất được phép chạy khi NODE_ENV=production (seed tự từ chối
#                     chế độ demo).
SEED_MODE=demo
# Dùng bởi `pnpm db:seed`. Đặt mật khẩu mạnh của riêng bạn. Ở production là BẮT BUỘC.
PLATFORM_ADMIN_EMAIL=admin@xeprime.vn
PLATFORM_ADMIN_PASSWORD=change-me
# Mật khẩu dùng chung cho MỌI tài khoản demo còn lại: chủ shop, nhân viên shop, khách thuê.
# Mặc định Abcd1234 nếu bỏ trống. (Trước đây tên là DEMO_OWNER_PASSWORD — đổi tên vì nó không
# còn chỉ áp cho chủ shop nữa; `.env` cũ cần sửa lại theo, nếu không sẽ rơi về mặc định.)
DEMO_PASSWORD=

# --- Email: thư mời thành viên + đặt lại mật khẩu (API) --------------------
# Gốc URL của web, dùng dựng link trong email. Production: bắt buộc https + tên miền thật.
APP_WEB_URL="http://localhost:3000"
#
# Dev: mặc định dưới đây trỏ vào Mailpit trong docker-compose.yml — thư đi thật qua SMTP
# nhưng dừng ở hộp thư local, xem tại http://localhost:8025 (HTML render đúng, link bấm
# được). Không cần tài khoản, không có đường nào ra Internet.
#   docker compose up -d mailpit
# Để TRỐNG SMTP_HOST thì quay về kiểu cũ: EmailService in nội dung ra log thay vì gửi.
#
# Mailpit không đòi đăng nhập nên USER/PASS để trống — đó là cấu hình hợp lệ, không phải
# thiếu. Ở production cả ba (HOST/USER/PASS) là BẮT BUỘC: link trong thư kèm token, mà
# thiếu SMTP nghĩa là token bị ghi thẳng ra log — API từ chối boot.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="XePrime DEV <no-reply@xeprime.local>"

# --- Web ------------------------------------------------------------------
# Cookie session là host-only: mở web bằng ĐÚNG hostname trong URL này (khác host là 401).
# Mở qua LAN thì đổi cả hai đầu sang cùng IP: NEXT_PUBLIC_API_URL="http://192.168.1.210:4000"
# và mở web bằng http://192.168.1.210:3000 (KHÔNG trộn localhost với IP — cookie host-only).
#
# ⚠️ Ở PRODUCTION, web và API nằm trên hai host (xeprime.vn / api.xeprime.vn) nên cookie
# host-only sẽ KHÔNG được web đọc. Phải đặt SESSION_COOKIE_DOMAIN=".xeprime.vn" — proxy của web
# đọc cookie phía server để chặn /manage, và callback OAuth (ADR 0019) đặt cookie ở origin API
# rồi redirect sang origin web.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Dev trên dữ liệu STAGING (tuỳ chọn) ----------------------------------
# Chạy web ở local nhưng dùng API + database của staging — không cần Docker, Postgres hay API
# local. Bật bằng cách đổi HAI dòng:
#
#   NEXT_PUBLIC_API_URL="http://localhost:3000/api/stg"
#   STG_PROXY_TARGET="https://api-stg.xeprime.vn"
#
# Trình duyệt chỉ nói chuyện với localhost (same-origin ⇒ không CORS, không cookie cross-site);
# Next chuyển tiếp sang staging ở phía server. KHÔNG phải sửa gì trên staging.
# Chi tiết và giới hạn: `apps/web/src/app/api/stg/[...path]/route.ts`.
#
# Bỏ trống = tắt hẳn. Route proxy cũng tự trả 404 khi NODE_ENV=production.
STG_PROXY_TARGET=

# Tên thương hiệu hiện ra giao diện web (`src/constants/app-name.ts`). KHÔNG phải chuỗi dịch —
# nó giống nhau ở cả vi lẫn en. App native có biến riêng `EXPO_PUBLIC_APP_NAME` ở
# `apps/mobile/.env`: mỗi bundler chỉ nhúng tiền tố của riêng nó, y như cặp API_URL ngay trên.
NEXT_PUBLIC_APP_NAME=XePrime

# --- Web: Firebase client (CHỈ chat realtime, ADR 0009) -------------------
# Từ ADR 0019 đăng nhập không còn dùng Firebase — bộ này chỉ để web nghe Firestore.
# Từ Firebase Console → Project settings → Web app config. Public (không phải secret),
# quyền thật do Firestore Security Rules quyết định.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Web: key VẼ BẢN ĐỒ (Geoapify Static Maps + Map Tiles — ADR 0037) -----
# Key này nằm LỘ THIÊN trong bundle — đó là bản chất của ảnh bản đồ và ô tile, không phải sơ
# suất. Vì thế trong Geoapify Projects nó phải khoá theo HTTP referrer/origin (đúng domain của
# web, cộng http://localhost:3000 cho máy dev).
# MỘT key lo cả hai việc: ảnh tĩnh ở trang xe/đơn, và tile của bản đồ kéo-ghim ở ô nhập địa chỉ.
# ⚠ KHÁC HẲN GEOAPIFY_API_KEY ở trên (geocoding + routing, khoá theo IP, chỉ backend gọi).
#   Dùng chung một key cho cả hai là mở hạn mức của mình cho bất kỳ ai xem trang.
# Bỏ trống thì mọi khối bản đồ tự ẩn và ô địa chỉ mất thao tác kéo ghim; phần địa chỉ, gợi ý
# địa điểm và quãng đường vẫn hiện bình thường.
NEXT_PUBLIC_GEOAPIFY_MAP_KEY=

# --- SePay: đối soát tiền VÀO tài khoản nền tảng (ADR 0016/0022, R2) -------
# Bốn biến là MỘT nhóm bật/tắt (khai nửa nhóm fail lúc boot). Chưa khai thì webhook trả 503
# SEPAY_NOT_CONFIGURED (fail closed) và màn thanh toán hoá đơn/hold chỉ còn mã + số tiền, không
# có VietQR. `SEPAY_API_KEY` là khoá WEBHOOK (SePay gửi lên), không phải khoá gọi API của SePay.
SEPAY_API_KEY=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=

# --- Worker (Phase 5+) ----------------------------------------------------
REDIS_URL="redis://localhost:6379"


# bắt buộc phải có để chạy push worker (ADR 0010). Nếu bỏ trống thì worker sẽ không chạy push.
FIREBASE_DEPLOY_CREDENTIALS_JSON=