# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database (ADR 0001: PostgreSQL 16) -----------------------------------
# Matches docker-compose.yml. Change the password before any non-local use.
DATABASE_URL="postgresql://xeprime:xeprime_dev_pw@localhost:5432/xeprime?schema=public"

# --- API ------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
# Comma-separated list. Must be exact origins in production, never "*".
CORS_ORIGINS="http://localhost:3000"

# --- Session (ADR 0002: httpOnly cookie issued by NestJS) -----------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_JWT_SECRET="change-me-dev-only-do-not-use-in-production-000000000000"
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=xp_session
# false only for local http. MUST be true in production.
SESSION_COOKIE_SECURE=false
# Leave empty for localhost; set to the apex domain in production.
SESSION_COOKIE_DOMAIN=

# --- Auth provider --------------------------------------------------------
# mock     -> AuthGuard accepts a fake token, for local dev without Firebase.
# firebase -> requires the three FIREBASE_* values below.
# See ADR 0002: only the verifier changes, the guard does not.
AUTH_MODE=mock

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole key including BEGIN/END lines, with literal \n for newlines.
FIREBASE_PRIVATE_KEY=

# --- Web ------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_NAME=XePrime

# --- Worker (Phase 5+) ----------------------------------------------------
REDIS_URL="redis://localhost:6379"
