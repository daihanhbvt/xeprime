node_modules/
.pnpm-store/

# build output
dist/
build/
.next/
out/
*.tsbuildinfo

# turbo
.turbo/

# env
.env
.env.*
# Lịch sử bản phát hành do deploy/scripts/deploy.sh ghi trên VPS (quyết định giữ image nào).
.deploy-releases.*
!.env.example

# prisma generated client
prisma/generated/
prisma/.env

# test / coverage
coverage/
test-results/
playwright-report/
.nyc_output/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor / os
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# claude: settings.json commit; settings.local.json là allowlist cá nhân.
# Plan mode ghi vào .claude/plans — plan theo phiên KHÔNG vào repo (docs/README.md)
.claude/settings.local.json
.claude/plans/

# secrets — never commit service account keys
*serviceAccount*.json
firebase-adminsdk-*.json

# git worktree phụ (agent) — không được để `git add -A` nuốt vào commit
.codex-worktrees/

# Project tracking - local only
XePrime_Project_Tracking.xlsx

# office lock file (~$Book.xlsx)

.uat-artifacts
~$*

# Bản dump DB tạo tay trước khi migrate — chứa DỮ LIỆU THẬT, không bao giờ vào git.
backups/

# Khối site của app ngoài XePrime — deploy của dự án đó cài lên VPS (docs/deployment.md §10).
/deploy/sites/*.caddy
/deploy/sites/*.bak
# Bản tạm lúc deploy/prodtemp/deploy.sh thay khối site (đổi tên xong là mất; còn lại = lần trước đỏ).
/deploy/sites/*.caddy.*
